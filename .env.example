# Project EYE — Environment Configuration

# Core App Settings
PROJECT_NAME="Project EYE — SOC-in-a-Box"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="eye-soc-in-a-box-development-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Config
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Settings (Defaults to SQLite for local development; switch to PostgreSQL for Docker/prod)
DATABASE_URL="sqlite+aiosqlite:///./eye_soc.db"
# DATABASE_URL="postgresql+asyncpg://eye_user:eye_password@localhost:5432/eye_db"

# Redis Cache / Queue Settings
REDIS_URL="redis://localhost:6379/0"

# AI Investigation Service Settings
# Provider options: "builtin" (no external key required), "gemini", "openai", "claude"
AI_PROVIDER="builtin"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
AI_TEMPERATURE=0.2

# Ingestion & Detection Settings
DEFAULT_INGESTION_RATE_LIMIT=500
CORRELATION_WINDOW_SECONDS=300
MAX_BATCH_INGESTION_SIZE=1000

# Telemetry Collector Settings
SYSLOG_UDP_PORT=5140
SYSLOG_TCP_PORT=5140
COLLECTOR_API_KEY="eye-collector-pre-shared-auth-key-2026"
